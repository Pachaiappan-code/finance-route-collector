# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (development database)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random 32-byte secret used to encrypt Auth.js sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-generated-secret"

# Only needed locally if deploying via the Vercel CLI instead of git push.
# Never commit this. Create at https://vercel.com/account/tokens
VERCEL_TOKEN="replace-with-your-vercel-token"
